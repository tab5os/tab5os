# Tab5 OS: settings shared by every build variant.
# Revision-specific settings live in sdkconfig.defaults.rev1 / .rev3.
CONFIG_IDF_TARGET="esp32p4"

# Flash: 16 MB, fixed partition layout (see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Console on USB-C (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM: 32 MB. 200 MHz is an experimental IDF option; drop to 80M if
# `psram test` reports errors on a unit.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=y

# Crash evidence survives reboot
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# OTA rollback is used from Phase 9; turning it on now keeps the bootloader
# behaviour the same from the first image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Phase 1
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=4
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_LITTLEFS_MAX_PARTITIONS=1
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Phase 2: no power management (DFS). IDF's DSI DPI driver holds a
# CPU_FREQ_MAX lock while the panel runs, and Sleep keeps the panel fed for
# touch (bench 0.8), so DFS never lowers the clock; it only adds lock traffic.
# Idle cores still wait in WFI. t5_power_hw_cpu_low() is ready if that changes.

# Phase 3: Wi-Fi through the ESP32-C6 (esp_hosted over SDIO, slot 1).
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
# t5_net powers the C6 (WLAN_PWR_EN on the expander) before starting the
# link, so no automatic init before app_main.
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# A dead C6 must not reboot the OS: t5_net power-cycles it instead.
CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE=n
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_NONE=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# Fast rejoin after a C6 reset or resume: reuse the last lease, skip the
# ~2 s ARP probe, and give the freshly powered C6 less settle time.
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
CONFIG_ESP_HOSTED_HOST_CP_RESET_SETTLE_MS=800
# BLE (plan 3.6): NimBLE on the P4, controller on the C6 over hosted HCI.
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
